{"timestamp_iso": "2026-11-07T23:52:20.515450+00:00", "event_type": "benchmark_run", "test_id": "LEN_03", "category": "length_boundary_edge_cases", "model_id": "M-QWEN-1.7B", "run_type": "REAL_INFERENCE", "iteration": 1, "input_text": "Certamente, arrivo subito!", "input_sha256": "079ad7b60cfabbac9b4dcdf9497a0c4aa2e06ec5e6aff225eefb4d2db0c04b86", "ref_audio_path": "bench/reference_voices/ref_voice_it_01.wav", "output_wav": "bench\\outputs\\M-QWEN-1.7B\\LEN_03.wav", "output_sha256": "360722f36757c4d22e8c986c9d7b8ea4c22b87254cdfb75774d11604742a5fe6", "sample_rate": 24000, "gen_time_sec": 13.1005, "duration_sec": 2.56, "rtf": 5.117, "sample_peak_dbfs": -2.19, "rms_dbfs": -22.39, "is_empty": false, "is_clipped": false, "trailing_silence_sec": 1.0, "trailing_silence_gt_2s": false, "peak_vram_allocated_mb": 4289.45, "peak_vram_reserved_mb": 5040.0, "nvidia_smi_used_mb": 5276.0}
{"timestamp_iso": "2026-11-07T23:54:07.144305+00:00", "event_type": "benchmark_run", "test_id": "LEN_04", "category": "length_boundary_edge_cases", "model_id": "M-QWEN-1.7B", "run_type": "REAL_INFERENCE", "iteration": 1, "input_text": "Era una notte buia e tempestosa, le onde si infrangevano con violenza inaudita contro la scogliera frastagliata del vecchio faro, mentre all'interno il guardiano lottava disperatamente per riaccendere la lampada a petrolio che si era spenta all'improvviso, lasciando l'intero promontorio nel buio più totale e minaccioso.", "input_sha256": "1cbe4759ea8b2e139486edfefb64142d25e1fecd9a1939b062ebff8ecc82c50a", "ref_audio_path": "bench/reference_voices/ref_voice_it_01.wav", "output_wav": "bench\\outputs\\M-QWEN-1.7B\\LEN_04.wav", "output_sha256": "d18b4ac45464daf1ad5fbbe9f7e09d0f89cf7b657f1471597203652d131b399d", "sample_rate": 24000, "gen_time_sec": 106.5043, "duration_sec": 20.88, "rtf": 5.101, "sample_peak_dbfs": -0.89, "rms_dbfs": -18.66, "is_empty": false, "is_clipped": false, "trailing_silence_sec": 0.2, "trailing_silence_gt_2s": false, "peak_vram_allocated_mb": 4756.03, "peak_vram_reserved_mb": 5460.0, "nvidia_smi_used_mb": 5696.0}
