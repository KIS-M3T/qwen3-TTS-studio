{"timestamp_iso": "2026-11-08T18:05:32.454480+00:00", "event_type": "benchmark_run", "test_id": "NAR_01", "category": "narrative_dialogues", "model_id": "M-QWEN-0.6B", "run_type": "REAL_INFERENCE", "iteration": 2, "input_text": "«Dove pensi di andare a quest'ora?», gli chiese Marta con voce tremante.", "input_sha256": "452f78cc21e8dce0c18bddca4ad4706a934b106c74d0c8f20f0d5b76376ba670", "ref_audio_path": "bench/reference_voices/ref_voice_it_01.wav", "output_wav": "bench\\outputs\\M-QWEN-0.6B\\NAR_01.wav", "output_sha256": "c251a8af4d55f9f73643a0a1fd31fa6ce04ee62f91abf5167a95bf2886304eda", "sample_rate": 24000, "gen_time_sec": 26.6035, "duration_sec": 5.44, "rtf": 4.89, "sample_peak_dbfs": -1.8, "rms_dbfs": -20.92, "is_empty": false, "is_clipped": false, "trailing_silence_sec": 0.6, "trailing_silence_gt_2s": false, "peak_vram_allocated_mb": 2441.63, "peak_vram_reserved_mb": 3666.0, "nvidia_smi_used_mb": 3902.0}
{"timestamp_iso": "2026-11-08T18:05:37.975570+00:00", "event_type": "benchmark_run", "test_id": "LEN_01", "category": "length_boundary_edge_cases", "model_id": "M-QWEN-0.6B", "run_type": "REAL_INFERENCE", "iteration": 2, "input_text": "Sì.", "input_sha256": "b473393d73e76854d0605fed672521bf40eb48230ab37a764069cdca4434faa4", "ref_audio_path": "bench/reference_voices/ref_voice_it_01.wav", "output_wav": "bench\\outputs\\M-QWEN-0.6B\\LEN_01.wav", "output_sha256": "c915752cb75d13c035a74dc289bf7a88669e38758afdc5a33878af01cd25f859", "sample_rate": 24000, "gen_time_sec": 5.4442, "duration_sec": 1.12, "rtf": 4.861, "sample_peak_dbfs": -8.66, "rms_dbfs": -29.65, "is_empty": false, "is_clipped": false, "trailing_silence_sec": 0.6, "trailing_silence_gt_2s": false, "peak_vram_allocated_mb": 2314.51, "peak_vram_reserved_mb": 3666.0, "nvidia_smi_used_mb": 3902.0}
{"timestamp_iso": "2026-11-08T18:05:47.772418+00:00", "event_type": "benchmark_run", "test_id": "LEN_02", "category": "length_boundary_edge_cases", "model_id": "M-QWEN-0.6B", "run_type": "REAL_INFERENCE", "iteration": 2, "input_text": "No, grazie.", "input_sha256": "06478df97160a5bfaf3c3aa3714768a338c2455d1381e92a1b9a30798f2e8348", "ref_audio_path": "bench/reference_voices/ref_voice_it_01.wav", "output_wav": "bench\\outputs\\M-QWEN-0.6B\\LEN_02.wav", "output_sha256": "b6ac320ba20b876e9706746edbe5bd5dbf405498a09e7b7408307164c5dc3081", "sample_rate": 24000, "gen_time_sec": 9.7259, "duration_sec": 2.0, "rtf": 4.863, "sample_peak_dbfs": -4.36, "rms_dbfs": -27.42, "is_empty": false, "is_clipped": false, "trailing_silence_sec": 0.6, "trailing_silence_gt_2s": false, "peak_vram_allocated_mb": 2340.4, "peak_vram_reserved_mb": 3666.0, "nvidia_smi_used_mb": 3902.0}
{"timestamp_iso": "2026-11-08T18:05:59.235531+00:00", "event_type": "benchmark_run", "test_id": "LEN_03", "category": "length_boundary_edge_cases", "model_id": "M-QWEN-0.6B", "run_type": "REAL_INFERENCE", "iteration": 2, "input_text": "Certamente, arrivo subito!", "input_sha256": "079ad7b60cfabbac9b4dcdf9497a0c4aa2e06ec5e6aff225eefb4d2db0c04b86", "ref_audio_path": "bench/reference_voices/ref_voice_it_01.wav", "output_wav": "bench\\outputs\\M-QWEN-0.6B\\LEN_03.wav", "output_sha256": "068875bb1df3ec9faba910f2d0b3205bf87f77d2cc6eb44071fe38fea860d655", "sample_rate": 24000, "gen_time_sec": 11.3815, "duration_sec": 2.32, "rtf": 4.906, "sample_peak_dbfs": -3.5, "rms_dbfs": -23.16, "is_empty": false, "is_clipped": false, "trailing_silence_sec": 0.5, "trailing_silence_gt_2s": false, "peak_vram_allocated_mb": 2349.82, "peak_vram_reserved_mb": 3666.0, "nvidia_smi_used_mb": 3902.0}
{"timestamp_iso": "2026-11-08T18:07:44.887279+00:00", "event_type": "benchmark_run", "test_id": "LEN_04", "category": "length_boundary_edge_cases", "model_id": "M-QWEN-0.6B", "run_type": "REAL_INFERENCE", "iteration": 2, "input_text": "Era una notte buia e tempestosa, le onde si infrangevano con violenza inaudita contro la scogliera frastagliata del vecchio faro, mentre all'interno il guardiano lottava disperatamente per riaccendere la lampada a petrolio che si era spenta all'improvviso, lasciando l'intero promontorio nel buio più totale e minaccioso.", "input_sha256": "1cbe4759ea8b2e139486edfefb64142d25e1fecd9a1939b062ebff8ecc82c50a", "ref_audio_path": "bench/reference_voices/ref_voice_it_01.wav", "output_wav": "bench\\outputs\\M-QWEN-0.6B\\LEN_04.wav", "output_sha256": "990d3167b785f09bd4b0b3dfd9c7ff19c9ef3312f5f8fe80668168261e43bd65", "sample_rate": 24000, "gen_time_sec": 105.5945, "duration_sec": 19.44, "rtf": 5.432, "sample_peak_dbfs": -2.73, "rms_dbfs": -21.03, "is_empty": false, "is_clipped": false, "trailing_silence_sec": 0.2, "trailing_silence_gt_2s": false, "peak_vram_allocated_mb": 2821.58, "peak_vram_reserved_mb": 3666.0, "nvidia_smi_used_mb": 3902.0}
{"timestamp_iso": "2026-11-08T18:09:37.355148+00:00", "event_type": "benchmark_run", "test_id": "LEN_05", "category": "length_boundary_edge_cases", "model_id": "M-QWEN-0.6B", "run_type": "REAL_INFERENCE", "iteration": 2, "input_text": "Capitolo primo: l'inizio del viaggio. La mattina del quattro ottobre partimmo presto da Bologna, diretti verso le montagne dell'Appennino tosco-emiliano. L'aria era frizzante e limpida, le prime foglie gialle cadevano dagli ippocastani lungo il viale della stazione, e nell'aria si avvertiva già quel profumo di legna bruciata tipico dell'autunno avanzato.", "input_sha256": "da5a7341aed41d070ae7bb25b34942bc19a1cd4cd9aad24dbf293411acad957f", "ref_audio_path": "bench/reference_voices/ref_voice_it_01.wav", "output_wav": "bench\\outputs\\M-QWEN-0.6B\\LEN_05.wav", "output_sha256": "6567e512e987bae9cdc06ce8cbf0d5641621e458cace1fa36475b319369991ee", "sample_rate": 24000, "gen_time_sec": 112.3732, "duration_sec": 22.56, "rtf": 4.981, "sample_peak_dbfs": -1.52, "rms_dbfs": -21.53, "is_empty": false, "is_clipped": false, "trailing_silence_sec": 0.3, "trailing_silence_gt_2s": false, "peak_vram_allocated_mb": 2821.68, "peak_vram_reserved_mb": 3666.0, "nvidia_smi_used_mb": 3902.0}
